{
  "theme": "gray",
  "tuiMode": "regular",
  "terminal": {
    "hyperlinks": true
  },
  "defaultProvider": "qwen-token-plan-cn",
  "defaultModel": "deepseek-v4.1-flash-1017",
  "subagents": {
    "disableBuiltins": true
  },
  "packages": [
    "npm:pi-simplify",
    "git:github.com/nicobailon/pi-subagents",
    "npm:pi-hashline-edit-pro",
    "npm:pi-web-access",
    "npm:@narumitw/pi-plan-mode",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-zentui",
    "npm:pi-compact-tools",
    "npm:@calesennett/pi-codex-fast"
  ],
  "pi-codex-fast": {
    "enabled": true,
    "mode": "fast"
  },
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "defaultTools": [
    "+codemode"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 10
    }
  },
  "compaction": {
    "reserveTokens": 500000,
    "modelOverrides": {
      "openai-codex/gpt-6.1-sol": { "reserveTokens": 20000 }
    }
  },
  "enabledModels": [
    "deepseek/deepseek-flash",
    "qwen-token-plan-cn/deepseek-v4.1-flash",
    "qwen-token-plan-cn/qwen3.8-max",
    "qwen-token-plan-cn/qwen3.8-flash",
    "qwen-token-plan-cn/deepseek-v4.1-flash-1017",
    "openai-codex/gpt-6.1-sol"
  ]
}
